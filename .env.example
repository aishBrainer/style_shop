# ---------------------------------------------------------------------------
# AI Fashion Studio — environment configuration
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=3000

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-do-not-use-in-production
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion
POSTGRES_DB=fashion_studio
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fashion:fashion@postgres:5432/fashion_studio

# --- Redis / queue ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO in dev, any S3-compatible in prod) --------------
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fashion-studio
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900

# --- Google OAuth (optional; leave blank to disable the button) ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Email (optional; falls back to console logging when unset) ------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aifashionstudio.local

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=20

# --- AI providers ----------------------------------------------------------
# Which concrete implementation each engine resolves to at worker start-up.
# "mock" runs on CPU and needs no weights — use it until you have picked a
# licensed checkpoint. See MODEL_LICENSE.md before switching any of these.
VTON_PROVIDER=mock
IMAGE_PROVIDER=mock
SEGMENTATION_PROVIDER=rembg
UPSCALE_PROVIDER=mock
VIDEO_PROVIDER=mock

AI_DEVICE=auto            # auto | cuda | cpu | mps
AI_WEIGHTS_DIR=/weights
MAX_CONCURRENT_JOBS_PER_WORKER=1
JOB_TIMEOUT_SECONDS=900
JOB_MAX_RETRIES=2

# Allow providers whose licence forbids commercial use. Keep false.
ALLOW_NON_COMMERCIAL_MODELS=false

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI Fashion Studio
